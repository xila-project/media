{
  "name": "@xila/media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "brand:sync": "python3 scripts/brand.py",
    "preview": "vite --host 127.0.0.1",
    "render": "node scripts/render.mjs",
    "startup": "python3 scripts/audio.py",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && python3 scripts/validate.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "python3 -m unittest discover -s tests -v",
    "clean": "python3 scripts/clean.py"
  },
  "dependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@motion-canvas/ui": "3.17.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@motion-canvas/vite-plugin": "3.17.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  },
  "overrides": {
    "vite": "$vite",
    "minimatch": "11.0.6"
  }
}
